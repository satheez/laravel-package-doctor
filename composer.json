{
    "name": "satheez/laravel-package-doctor",
    "description": "Audit a Laravel project's Composer dependencies for upgrade safety, security, and Laravel compatibility.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "composer",
        "dependencies",
        "package-health",
        "audit",
        "outdated",
        "security",
        "ci",
        "dependency-analysis"
    ],
    "authors": [
        {
            "name": "Satheez",
            "email": "mysatheez@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "composer/semver": "^3.4",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Satheez\\PackageDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Satheez\\PackageDoctor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Satheez\\PackageDoctor\\PackageDoctorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "stan": "vendor/bin/phpstan analyse",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
